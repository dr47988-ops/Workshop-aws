            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{authRefresh}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.unset('authAccess'); pm.collectionVariables.unset('authRefresh');"
                ]
              }
            }
          ]
        }
