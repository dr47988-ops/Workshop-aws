    {
      "name": "2. Eventos",
      "item": [
        {
          "name": "POST /events",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 7 * 24 * 3600 * 1000);",
                  "pm.collectionVariables.set('futureDate', d.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const e = pm.response.json().data;",
                  "pm.test('Nace en DRAFT', () => pm.expect(e.status).to.eql('DRAFT'));",
                  "pm.collectionVariables.set('eventId', e._id);",
                  "pm.collectionVariables.set('ticketTypeId', e.ticketTypes[0]._id);",
                  "pm.collectionVariables.set('ticketTypeVipId', e.ticketTypes[1]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Concierto Workshop\",\n  \"description\": \"Evento de prueba desde Postman\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"location\": \"San Carlos, Alajuela\",\n  \"date\": \"{{futureDate}}\",\n  \"ticketTypes\": [\n    {\n      \"name\": \"General\",\n      \"price\": 10000,\n      \"capacity\": 5\n    },\n    {\n      \"name\": \"VIP\",\n      \"price\": 25000,\n      \"capacity\": 2\n    }\n  ]\n}"
            },
            "url": {
