    {
      "name": "2. Eventos",
      "item": [
        {
          "name": "POST /events",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = new Date(Date.now() + 7 * 24 * 3600 * 1000);",
                  "pm.collectionVariables.set('futureDate', d.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const e = pm.response.json().data;",
                  "pm.test('Nace en DRAFT', () => pm.expect(e.status).to.eql('DRAFT'));",
                  "pm.collectionVariables.set('eventId', e._id);",
                  "pm.collectionVariables.set('ticketTypeId', e.ticketTypes[0]._id);",
                  "pm.collectionVariables.set('ticketTypeVipId', e.ticketTypes[1]._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
